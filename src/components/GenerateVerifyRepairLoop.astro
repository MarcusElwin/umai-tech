---
/**
 * Visual for the core harness loop: the model generates, a deterministic
 * verifier disposes, structured errors feed a repair attempt, and after
 * max_tries the task escalates to a human with the full trail.
 */
export interface Props {
  title?: string;
}

const { title = 'The harness loop: generate → verify → repair' } = Astro.props;

const stages = [
  {
    step: '1',
    name: 'Generate',
    owner: 'probabilistic · the model',
    accent: '#8B5CF6',
    description: 'The LLM proposes a candidate — an extraction, a plan, a draft, a diff — doing what it is genuinely great at: reading language, emitting structure.',
  },
  {
    step: '2',
    name: 'Verify',
    owner: 'deterministic · your code',
    accent: '#10B981',
    description: 'Schemas, playbook rules, invariants, and tests run against the candidate. Output is a list of specific, machine-readable failures — or an empty list.',
  },
  {
    step: '3',
    name: 'Repair',
    owner: 'the feedback edge',
    accent: '#F59E0B',
    description: 'Structured errors — not "try harder" — feed the next generation. The model is told exactly what broke and regenerates against it.',
  },
];
---

<figure
  class="not-prose my-8 rounded-3xl border border-umai-gray-200 bg-white p-5 shadow-2xl shadow-umai-gray-900/10 dark:border-umai-gray-700 dark:bg-umai-gray-900/80 sm:p-6"
  aria-labelledby="gvr-loop-title"
>
  <div class="mb-6 max-w-3xl border-b border-umai-gray-200 pb-5 dark:border-umai-gray-700">
    <div class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-umai-accent">the harness pattern</div>
    <h3 id="gvr-loop-title" class="text-2xl font-bold tracking-tight text-umai-primary dark:text-umai-secondary sm:text-3xl">
      {title}
    </h3>
    <div class="mt-3 text-sm leading-7 text-umai-gray-600 dark:text-umai-gray-300">
      The model proposes, a deterministic verifier disposes. Two exits, both honest: green means
      ship; <code class="rounded bg-black/5 px-1 py-0.5 font-mono text-xs dark:bg-white/10">max_tries</code> exceeded
      means escalate to a human with the full trail.
    </div>
  </div>

  <div class="flex flex-col items-stretch gap-3 lg:flex-row lg:items-stretch">
    {stages.map((stage, i) => (
      <>
        <article class="relative flex-1 overflow-hidden rounded-2xl border border-umai-gray-200 bg-umai-gray-50 p-4 dark:border-umai-gray-700 dark:bg-umai-gray-800/70">
          <div class="absolute inset-x-0 top-0 h-1" style={`background-color: ${stage.accent}`}></div>
          <div class="mb-2 flex items-center gap-2.5">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full font-mono text-sm font-bold text-white"
              style={`background-color: ${stage.accent}`}
            >
              {stage.step}
            </span>
            <h4 class="font-mono text-base font-bold tracking-tight text-umai-gray-900 dark:text-white">{stage.name}</h4>
          </div>
          <div class="mb-2 text-[0.65rem] font-bold uppercase tracking-[0.12em]" style={`color: ${stage.accent}`}>
            {stage.owner}
          </div>
          <p class="text-sm leading-6 text-umai-gray-600 dark:text-umai-gray-300">{stage.description}</p>
        </article>
        {i < stages.length - 1 && (
          <div class="flex items-center justify-center text-umai-gray-400 dark:text-umai-gray-500" aria-hidden="true">
            <svg class="hidden h-5 w-8 lg:block" viewBox="0 0 32 20" fill="none">
              <path d="M2 10h26m0 0l-6-5m6 5l-6 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg class="h-8 w-5 lg:hidden" viewBox="0 0 20 32" fill="none">
              <path d="M10 2v26m0 0l-5-6m5 6l5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        )}
      </>
    ))}
  </div>

  <div class="mt-3 flex flex-col items-center gap-2 text-xs font-medium text-umai-gray-400 dark:text-umai-gray-500 lg:flex-row lg:justify-center lg:gap-3">
    <svg class="hidden h-4 w-40 lg:block" viewBox="0 0 160 16" fill="none" aria-hidden="true">
      <path d="M156 8H10m0 0l6-5m-6 5l6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 4" />
    </svg>
    <span>errors loop back to <span class="font-mono font-bold text-umai-accent">Generate</span> until green or <span class="font-mono">max_tries</span></span>
  </div>

  <div class="mt-5 grid gap-3 sm:grid-cols-2">
    <div class="rounded-2xl border border-green-500/25 bg-green-50/80 p-4 dark:border-green-500/30 dark:bg-green-950/30">
      <div class="flex items-center gap-2">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-green-500 text-white">
          <svg class="h-3.5 w-3.5" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        </span>
        <h4 class="font-mono text-sm font-bold text-green-800 dark:text-green-300">verify() → []</h4>
      </div>
      <p class="mt-2 text-sm leading-6 text-green-700 dark:text-green-200">
        Ship it. Every check the domain cares about passed — and the passing run is recorded as
        evidence, not asserted as vibes.
      </p>
    </div>
    <div class="rounded-2xl border border-rose-500/25 bg-rose-50/80 p-4 dark:border-rose-500/30 dark:bg-rose-950/30">
      <div class="flex items-center gap-2">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-rose-500 text-white">
          <svg class="h-3.5 w-3.5" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 4h.01M4.93 19h14.14c1.54 0 2.5-1.67 1.73-3L13.73 5c-.77-1.33-2.69-1.33-3.46 0L3.2 16c-.77 1.33.19 3 1.73 3z" /></svg>
        </span>
        <h4 class="font-mono text-sm font-bold text-rose-800 dark:text-rose-300">max_tries → escalate</h4>
      </div>
      <p class="mt-2 text-sm leading-6 text-rose-700 dark:text-rose-200">
        Hand off to a human with the full trail of attempts and failures. Escalation is a feature —
        the verifier defines the boundary of the system’s competence.
      </p>
    </div>
  </div>
</figure>
