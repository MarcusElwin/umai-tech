---
/**
 * High-level architecture of a generic coding harness (Claude Code, pi,
 * DeepAgents, Codex CLI, ...): four layers around one agent loop, with the
 * cross-cutting concerns that make it production-grade. The model is the
 * only component you rent — everything else is the harness.
 */
export interface Props {
  title?: string;
}

const { title = 'Anatomy of a coding harness' } = Astro.props;

const loopSteps = [
  {
    step: '1',
    name: 'Assemble context',
    detail: 'System prompt, AGENTS.md / CLAUDE.md, repo map, conversation, todo state',
  },
  {
    step: '2',
    name: 'Model proposes',
    detail: 'The LLM plans and emits the next action — text, tool call, or code',
    rented: true,
  },
  {
    step: '3',
    name: 'Dispatch tools',
    detail: 'The harness executes the call against the real environment',
  },
  {
    step: '4',
    name: 'Observe & append',
    detail: 'Results, diffs, and errors feed back into context — then loop',
  },
];

const layers = [
  {
    label: 'Interface',
    note: 'where the work arrives',
    items: ['CLI / terminal', 'IDE extension', 'CI & GitHub events', 'Chat / web'],
  },
  {
    label: 'Tools',
    note: 'the action space',
    items: ['Read / edit files', 'Shell & exec', 'Search / grep', 'Web fetch', 'Subagents & tasks'],
  },
  {
    label: 'Environment',
    note: 'where ground truth lives',
    items: ['Filesystem', 'Git', 'Test runner', 'Sandbox / network policy'],
  },
];

const crossCutting = [
  {
    name: 'Permissions & sandboxing',
    detail: 'Least-privilege tool access, approval gates, isolated execution for untrusted code.',
  },
  {
    name: 'Memory & compaction',
    detail: 'Todo lists, notes-to-self, context summarization when the window fills up.',
  },
  {
    name: 'Verifiers',
    detail: 'Tests, typecheck, lint, build — deterministic feedback the loop can trust.',
  },
];
---

<figure
  class="not-prose my-8 rounded-3xl border border-umai-gray-200 bg-white p-5 shadow-2xl shadow-umai-gray-900/10 dark:border-umai-gray-700 dark:bg-umai-gray-900/80 sm:p-6"
  aria-labelledby="coding-harness-anatomy-title"
>
  <div class="mb-6 flex flex-col gap-3 border-b border-umai-gray-200 pb-5 dark:border-umai-gray-700 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <div class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-umai-accent">the universal agent, unpacked</div>
      <h3 id="coding-harness-anatomy-title" class="text-2xl font-bold tracking-tight text-umai-primary dark:text-umai-secondary sm:text-3xl">
        {title}
      </h3>
      <div class="mt-3 text-sm leading-7 text-umai-gray-600 dark:text-umai-gray-300">
        Every serious coding agent converges on the same shape: one loop, three supporting layers,
        three cross-cutting concerns — and exactly one component you rent.
      </div>
    </div>
    <div class="flex flex-wrap gap-1.5 lg:justify-end">
      {['Claude Code', 'pi', 'DeepAgents', 'Codex CLI'].map((name) => (
        <span class="rounded-full border border-umai-gray-200 bg-umai-gray-50 px-2.5 py-1 font-mono text-[0.65rem] font-bold text-umai-gray-600 dark:border-umai-gray-700 dark:bg-umai-gray-800 dark:text-umai-gray-300">
          {name}
        </span>
      ))}
    </div>
  </div>

  <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_240px]">
    <div class="flex flex-col gap-3">
      {/* Interface layer */}
      <section class="rounded-2xl border border-umai-gray-200 bg-umai-gray-50 p-4 dark:border-umai-gray-700 dark:bg-umai-gray-800/70">
        <div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h4 class="font-mono text-sm font-bold tracking-tight text-umai-gray-900 dark:text-white">{layers[0].label}</h4>
          <span class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-umai-gray-400 dark:text-umai-gray-500">{layers[0].note}</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {layers[0].items.map((item) => (
            <span class="rounded-lg border border-umai-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-umai-gray-700 dark:border-umai-gray-600 dark:bg-umai-gray-900/60 dark:text-umai-gray-200">
              {item}
            </span>
          ))}
        </div>
      </section>

      <div class="flex justify-center text-umai-gray-400 dark:text-umai-gray-500" aria-hidden="true">
        <svg class="h-5 w-4" viewBox="0 0 16 20" fill="none"><path d="M8 2v14m0 0l-5-5m5 5l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </div>

      {/* The agent loop — the core */}
      <section class="relative overflow-hidden rounded-2xl border-2 border-umai-accent/40 bg-purple-50/60 p-4 dark:border-umai-accent/50 dark:bg-purple-950/20">
        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-umai-accent to-umai-accent-light"></div>
        <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h4 class="font-mono text-sm font-bold tracking-tight text-umai-gray-900 dark:text-white">The agent loop</h4>
          <span class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-umai-accent">runs until done — or escalates</span>
        </div>
        <ol class="grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
          {loopSteps.map((s) => (
            <li class={`relative rounded-xl border p-3 ${s.rented ? 'border-amber-400/60 bg-amber-50/80 dark:border-amber-500/40 dark:bg-amber-950/30' : 'border-umai-gray-200 bg-white dark:border-umai-gray-600 dark:bg-umai-gray-900/60'}`}>
              <div class="mb-1 flex items-center justify-between gap-2">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-umai-accent font-mono text-[0.65rem] font-bold text-white">{s.step}</span>
                {s.rented && (
                  <span class="rounded-full bg-amber-500 px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.1em] text-white">rented</span>
                )}
              </div>
              <div class="text-xs font-bold text-umai-gray-900 dark:text-white">{s.name}</div>
              <p class="mt-1 text-[0.7rem] leading-5 text-umai-gray-600 dark:text-umai-gray-300">{s.detail}</p>
            </li>
          ))}
        </ol>
        <p class="mt-3 text-center text-[0.7rem] font-medium text-umai-gray-500 dark:text-umai-gray-400">
          ↺ step 4 loops back to step 1 with richer context — the model is the only step the harness doesn’t own
        </p>
      </section>

      <div class="flex justify-center text-umai-gray-400 dark:text-umai-gray-500" aria-hidden="true">
        <svg class="h-5 w-4" viewBox="0 0 16 20" fill="none"><path d="M8 2v14m0 0l-5-5m5 5l5-5M8 16V2m0 0L3 7m5-5l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </div>

      {/* Tools + environment layers */}
      {layers.slice(1).map((layer, i) => (
        <>
          <section class="rounded-2xl border border-umai-gray-200 bg-umai-gray-50 p-4 dark:border-umai-gray-700 dark:bg-umai-gray-800/70">
            <div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h4 class="font-mono text-sm font-bold tracking-tight text-umai-gray-900 dark:text-white">{layer.label}</h4>
              <span class="text-[0.65rem] font-bold uppercase tracking-[0.12em] text-umai-gray-400 dark:text-umai-gray-500">{layer.note}</span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {layer.items.map((item) => (
                <span class="rounded-lg border border-umai-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-umai-gray-700 dark:border-umai-gray-600 dark:bg-umai-gray-900/60 dark:text-umai-gray-200">
                  {item}
                </span>
              ))}
            </div>
          </section>
          {i === 0 && (
            <div class="flex justify-center text-umai-gray-400 dark:text-umai-gray-500" aria-hidden="true">
              <svg class="h-5 w-4" viewBox="0 0 16 20" fill="none"><path d="M8 2v14m0 0l-5-5m5 5l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
          )}
        </>
      ))}
    </div>

    {/* Cross-cutting concerns */}
    <aside class="flex flex-col gap-3">
      <div class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-umai-gray-400 dark:text-umai-gray-500 lg:pt-1">
        Cross-cutting — wraps every layer
      </div>
      {crossCutting.map((c) => (
        <div class="flex-1 rounded-2xl border border-dashed border-umai-gray-300 bg-white p-3.5 dark:border-umai-gray-600 dark:bg-umai-gray-800/50">
          <div class="text-xs font-bold text-umai-gray-900 dark:text-white">{c.name}</div>
          <p class="mt-1 text-[0.7rem] leading-5 text-umai-gray-600 dark:text-umai-gray-300">{c.detail}</p>
        </div>
      ))}
    </aside>
  </div>
</figure>
