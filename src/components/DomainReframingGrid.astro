---
/**
 * Grid showing how domain problems reframe onto the code substrate:
 * vibes task → coding problem → deterministic verifier.
 */
const domains = [
  {
    name: 'Legal',
    accent: '#8B5CF6',
    vibes: '"Review this contract and tell me if it looks OK."',
    coding: 'Structured extraction into typed schemas + the firm playbook as version-controlled rules.',
    verifier: 'Pydantic validation · check_playbook() · LegalBench-style reference answers',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>',
  },
  {
    name: 'Commerce',
    accent: '#10B981',
    vibes: '"Suggest something to upsell this customer."',
    coding: 'Executable invariants over carts and offers + protocol schemas (ACP, UCP, AP2, MCP).',
    verifier: 'chooseUpsell() unit tests · JSON Schema validation · capability intersection',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>',
  },
  {
    name: 'Healthcare',
    accent: '#3B82F6',
    vibes: '"Draft a prior-auth request for this patient."',
    coding: 'FHIR resources as the type system + payer criteria encoded as procedure-level rules.',
    verifier: 'FHIR resource validation · payer rules engine · CMS-0057-F ePA APIs',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>',
  },
  {
    name: 'Tax & Gov',
    accent: '#F59E0B',
    vibes: '"Work out what benefits this household is entitled to."',
    coding: 'Statutes as literate programs — Catala’s prioritized default logic mirrors base-case/exception law.',
    verifier: 'Catala compiler · DGFiP test suites · OECD rules-as-code twin texts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
  },
  {
    name: 'Finance',
    accent: '#EC4899',
    vibes: '"Check whether this trade breaks any of our limits."',
    coding: 'Positions and mandates as typed data + risk limits and compliance policy as executable checks.',
    verifier: 'Limit-check functions · reconciliation against the ledger · audit-trail replay',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>',
  },
  {
    name: 'Your domain',
    accent: '#6B7280',
    vibes: '"Look at this and use your judgment."',
    coding: 'Find the typed data hiding in the prose, and the policy hiding in people’s heads. Write both down as code.',
    verifier: 'Schema → rules → repair loop → regression evals',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
  },
];
---

<section
  class="not-prose my-8 rounded-3xl border border-umai-gray-200 bg-white p-4 shadow-2xl shadow-umai-gray-900/10 dark:border-umai-gray-700 dark:bg-umai-gray-900/80 sm:p-6"
  aria-labelledby="domain-reframing-title"
>
  <div class="mb-6 max-w-3xl border-b border-umai-gray-200 pb-5 dark:border-umai-gray-700">
    <div class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-umai-accent">the reframing recipe</div>
    <h3 id="domain-reframing-title" class="text-2xl font-bold tracking-tight text-umai-primary dark:text-umai-secondary sm:text-3xl">
      Vibes task → coding problem → verifier
    </h3>
    <div class="mt-3 text-sm leading-7 text-umai-gray-600 dark:text-umai-gray-300">
      The same three-step reframing, applied across domains. The model handles language; typed
      schemas carry the data; deterministic code owns the judgment.
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    {domains.map((domain) => (
      <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-umai-gray-200 bg-umai-gray-50 p-4 transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-xl dark:border-umai-gray-700 dark:bg-umai-gray-800/70 dark:hover:bg-umai-gray-800">
        <div
          class="absolute inset-x-0 top-0 h-1 opacity-60 transition-opacity duration-300 group-hover:opacity-100"
          style={`background-color: ${domain.accent}`}
        ></div>
        <div class="mb-3 flex items-center gap-2.5">
          <span
            class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg text-white"
            style={`background-color: ${domain.accent}`}
          >
            <svg class="h-4.5 w-4.5" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <Fragment set:html={domain.icon} />
            </svg>
          </span>
          <h4 class="text-base font-bold tracking-tight text-umai-gray-900 dark:text-white">{domain.name}</h4>
        </div>
        <dl class="flex flex-1 flex-col gap-2.5 text-sm">
          <div>
            <dt class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-umai-gray-400 dark:text-umai-gray-500">Vibes task</dt>
            <dd class="mt-0.5 italic leading-5 text-umai-gray-600 dark:text-umai-gray-300">{domain.vibes}</dd>
          </div>
          <div>
            <dt class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-umai-gray-400 dark:text-umai-gray-500">Coding problem</dt>
            <dd class="mt-0.5 leading-5 text-umai-gray-700 dark:text-umai-gray-200">{domain.coding}</dd>
          </div>
          <div class="mt-auto">
            <dt class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-umai-gray-400 dark:text-umai-gray-500">Verifier</dt>
            <dd class="mt-1 overflow-x-auto rounded-lg bg-umai-gray-900 px-3 py-2 font-mono text-[0.68rem] leading-5 text-green-400 dark:bg-umai-gray-900/90">
              {domain.verifier}
            </dd>
          </div>
        </dl>
      </article>
    ))}
  </div>
</section>
